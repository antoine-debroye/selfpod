{
  "name": "selfpod",
  "version": "1.1.0",
  "description": "SelfPod \u2014 a self-hosted podcast server. Drop a file in a folder; it's an episode.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "DATA_DIR=./.devdata LOG_LEVEL=debug node --watch src/index.js",
    "scan": "node scripts/scan-once.js",
    "test": "node --test \"test/unit/*.test.js\" \"test/integration/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\"",
    "reset-password": "node scripts/reset-password.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "9.0.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/session": "11.1.2",
    "@fastify/static": "10.1.3",
    "@fastify/view": "12.0.0",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "chokidar": "4.0.3",
    "eta": "4.6.0",
    "fastify": "5.11.3",
    "fastify-plugin": "6.0.0",
    "music-metadata": "11.14.0",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "sharp": "0.35.3",
    "xmlbuilder2": "4.0.3"
  },
  "devDependencies": {
    "pino-pretty": "13.1.3"
  },
  "keywords": [
    "podcast",
    "rss",
    "self-hosted",
    "docker",
    "truenas",
    "homelab"
  ]
}
