<div class="page-title">
  <div>
    <div class="sub">
      <%= it.shows.length %> show<%= it.shows.length === 1 ? '' : 's' %><%
      %><% if (it.lastScan) { %> · last full scan <%= it.helpers.relativeTime(it.lastScan.finishedAt) %><% } %>
    </div>
    <h1>Your workshop</h1>
  </div>
</div>

<% if (it.watcherNotice) { %>
  <div class="notice info" id="watcher-notice" data-dismissible="watcher-notice">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
    <div><%= it.watcherNotice %></div>
    <button class="notice__dismiss" type="button" data-dismiss="watcher-notice" aria-label="Dismiss">×</button>
  </div>
<% } %>

<div id="scan-progress-slot">
  <%~ it.scanProgress || '' %>
</div>

<%~ include('../partials/show-grid', it) %>

<% if (it.pausedShows.length) { %>
  <section class="form-card danger-zone" style="margin-top:22px">
    <div class="ftitle">Paused shows</div>
    <div class="fdesc">
      These folders are no longer in <code><%= it.showsDir %></code>. Their feeds are paused, but nothing has
      been deleted — put the folder back and they resume with the same episode identities.
    </div>
    <% for (const show of it.pausedShows) { %>
      <div class="set-row">
        <div class="info">
          <div class="t"><%= show.title %></div>
          <div class="d">Missing since <%= it.helpers.formatDateTime(show.folderMissingSince) %> · <code><%= show.folder %></code></div>
        </div>
        <button class="btn btn-ghost btn-sm"
                hx-get="/ui/modals/delete-show/<%= encodeURIComponent(show.slug) %>"
                hx-target="#modal-root" hx-swap="innerHTML">Remove show…</button>
      </div>
    <% } %>
  </section>
<% } %>
