<%
  const show = it.show;
%>
<div class="page-title">
  <div>
    <div class="sub">What is cut from <%= show.title %>, and why</div>
    <h1>Adverts</h1>
  </div>
  <div class="actions">
    <a class="btn btn-ghost btn-sm" href="/shows/<%= encodeURIComponent(show.slug) %>">Back to show</a>
  </div>
</div>

<%~ include('../partials/ad-panel.eta', it) %>
