<%
  const show = it.show;
  const mode = it.mode ?? 'off';
%>
<div class="page-title">
  <div>
    <div class="sub">Sponsor reads and repeated audio in <%= show.title %></div>
    <h1>Adverts</h1>
  </div>
  <div class="actions">
    <a class="btn btn-ghost btn-sm" href="/shows/<%= encodeURIComponent(show.slug) %>">Back to show</a>
  </div>
</div>

<div class="grid-2">
  <div>
    <form class="form-card" method="post"
          action="/ui/shows/<%= encodeURIComponent(show.slug) %>/ad-trim"
          hx-post="/ui/shows/<%= encodeURIComponent(show.slug) %>/ad-trim"
          hx-target="#ad-segments" hx-swap="outerHTML">
      <div class="ftitle">What SelfPod should do</div>

      <fieldset class="modal__choices">
        <legend class="sr-only">What should SelfPod do about repeated audio?</legend>

        <label class="choice">
          <input type="radio" name="mode" value="off" <%= mode === 'off' ? 'checked' : '' %>>
          <span class="choice__body">
            <strong>Nothing</strong>
            <small>Your episodes are published exactly as they arrive. SelfPod does not
              listen to them or read them.</small>
          </span>
        </label>

        <label class="choice">
          <input type="radio" name="mode" value="review" <%= mode === 'review' ? 'checked' : '' %>>
          <span class="choice__body">
            <strong>Listen, tell me what it heard, and wait</strong>
            <small>SelfPod reads the opening and closing minutes of each episode and holds
              the episode until you have decided about anything that sounds like a sponsor
              read or repeats across episodes. Once you have removed a read, the same
              words are cut from later episodes without asking — that decision was yours.</small>
          </span>
        </label>

        <label class="choice">
          <input type="radio" name="mode" value="auto" <%= mode === 'auto' ? 'checked' : '' %>>
          <span class="choice__body">
            <strong>Remove what it is sure about, without asking</strong>
            <small>It cuts a stretch when the words say sponsor read — a promo code,
              “brought to you by”, a web address — and the same words come back in
              other episodes, or when you have removed that read before. Anything it is
              unsure of is listed here and the episode is published untouched. It still
              will not touch a theme tune or credits on its own.</small>
          </span>
        </label>
      </fieldset>

      <fieldset class="listen-scope">
        <legend class="ds-caption">Where to listen</legend>
        <div class="form-row">
          <div class="field">
            <label for="listen-head">First</label>
            <div class="field-unit">
              <input id="listen-head" type="number" name="listenHeadMinutes" min="0" max="15" step="1"
                     value="<%= it.listen?.headMinutes ?? 5 %>"> <span class="muted">minutes</span>
            </div>
          </div>
          <div class="field">
            <label for="listen-tail">Last</label>
            <div class="field-unit">
              <input id="listen-tail" type="number" name="listenTailMinutes" min="0" max="15" step="1"
                     value="<%= it.listen?.tailMinutes ?? 4 %>"> <span class="muted">minutes</span>
            </div>
          </div>
        </div>
        <label class="choice choice--inline">
          <input type="checkbox" name="listenWhole" value="1" <%= it.listen?.whole ? 'checked' : '' %>>
          <span class="choice__body">
            <strong>The whole episode</strong>
            <small>Catches mid-roll reads too. Costs as much work as the episode is long.</small>
          </span>
        </label>
        <div class="hint">
          <% if (it.listen?.rateLabel) { %>
            Reading speech is the expensive part. On this machine it runs at about
            <%= it.listen.rateLabel %>, so <%= it.listen.costLabel %>.
          <% } else { %>
            Reading speech is the expensive part of this feature. On a small NAS it runs
            at roughly real time, so the first 5 and last 4 minutes of an episode is a
            few minutes of work; a desktop is many times faster. SelfPod measures its
            own speed and says so here once it has listened to something.
          <% } %>
        </div>
      </fieldset>

      <div class="field">
        <label for="min-episodes">Episodes a read must appear in before SelfPod cuts it unasked</label>
        <input id="min-episodes" type="number" name="minEpisodes" min="2" max="20"
               value="<%= it.minEpisodes ?? 3 %>">
        <div class="hint">
          Audio has to appear in this many episodes before SelfPod will act on it alone.
          Words that sound like a sponsor read need only two. Fewer finds reads sooner,
          and finds more things that are not reads.
        </div>
      </div>

      <div class="actions">
        <button class="btn btn-sm" type="submit">Save</button>
      </div>
    </form>

    <% if (mode !== 'off') { %>
      <form class="form-card" method="post"
            action="/ui/shows/<%= encodeURIComponent(show.slug) %>/ad-detect"
            hx-post="/ui/shows/<%= encodeURIComponent(show.slug) %>/ad-detect"
            hx-target="#ad-segments" hx-swap="outerHTML">
        <div class="ftitle">Look again now</div>
        <p class="muted">
          SelfPod does this on its own after each scan. This is for when you have just
          added episodes and would rather not wait.
        </p>
        <button class="btn btn-ghost btn-sm" type="submit">Check this show now</button>
      </form>
    <% } %>
  </div>

  <div>
    <%~ include('../partials/ad-segments.eta', {
      show,
      segments: it.segments,
      mode,
      held: it.held,
      listening: it.listening,
      lookedAndFoundNothing: it.lookedAndFoundNothing,
      comparableEpisodes: it.comparableEpisodes,
      helpers: it.helpers,
    }) %>
  </div>
</div>
