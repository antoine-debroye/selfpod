<%
  const episode = it.episode;
  const show = it.show;
%>
<div class="page-title">
  <div>
    <div class="sub mono"><%= episode.filename %> · <%= episode.mimeType %></div>
    <h1>Edit episode</h1>
  </div>
  <div class="actions">
    <button class="btn btn-danger btn-sm" type="button"
            hx-get="/ui/modals/delete-episode/<%= encodeURIComponent(episode.id) %>"
            hx-target="#modal-root" hx-swap="innerHTML">Remove or delete…</button>
  </div>
</div>

<% if (episode.status === 'missing') { %>
  <div class="notice warn" style="margin-bottom:18px">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
    <div>This episode's file is not on disk right now, so it stays in the feed in case the share is
      briefly unavailable. It drops out automatically once the grace period passes.</div>
  </div>
<% } else if (episode.status === 'removed') { %>
  <div class="notice info" style="margin-bottom:18px">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
    <div>
      This episode is not in the feed. The audio file is still on disk, and rescans will leave it out.
      <form method="post" action="/ui/episodes/<%= encodeURIComponent(episode.id) %>/restore" class="inline-form">
        <button class="btn btn-ghost btn-sm" type="submit">Restore to feed</button>
      </form>
    </div>
  </div>
<% } %>

<div class="form-card file-facts">
  <div class="file-facts__icon" aria-hidden="true">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="12" x2="6" y2="12"/><line x1="9" y1="8" x2="9" y2="16"/><line x1="12" y1="5" x2="12" y2="19"/><line x1="15" y1="8" x2="15" y2="16"/><line x1="18" y1="11" x2="18" y2="13"/></svg>
  </div>
  <div class="file-facts__main">
    <div class="ds-caption">Audio preview</div>
    <div class="waveform" aria-hidden="true">
      <% for (const height of it.helpers.waveformBars(episode.id) ) { %><i style="height:<%= height %>%"></i><% } %>
    </div>
    <audio class="file-facts__player" controls preload="none" src="<%= episode.localMediaUrl %>">
      <a href="<%= episode.localMediaUrl %>">Download this episode</a>
    </audio>
  </div>
  <div class="file-facts__stats">
    <span class="mono"><%= it.helpers.formatDuration(episode.durationSeconds) %></span>
    <span class="mono"><%= it.helpers.formatBytes(episode.fileSizeBytes) %></span>
    <span class="mono"><%= episode.bitrateKbps ? episode.bitrateKbps + ' kbps' : '—' %></span>
  </div>
</div>

<%~ include('../partials/episode-form', { episode, show, helpers: it.helpers }) %>
