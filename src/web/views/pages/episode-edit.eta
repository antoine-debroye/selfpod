<%
  const episode = it.episode;
  const show = it.show;
%>
<div class="page-title">
  <div>
    <div class="sub mono"><%= episode.filename %> · <%= episode.mimeType %> · <span
      title="SelfPod first saw this file on <%= it.helpers.formatDateTime(episode.createdAt) %>">added <%= it.helpers.relativeTime(episode.createdAt) %></span></div>
    <h1>Edit episode</h1>
  </div>
  <div class="actions">
    <button class="btn btn-danger btn-sm" type="button"
            hx-get="/ui/modals/delete-episode/<%= encodeURIComponent(episode.id) %>"
            hx-target="#modal-root" hx-swap="innerHTML">Remove or delete…</button>
  </div>
</div>

<% if (episode.scheduled) { %>
  <div class="notice info" style="margin-bottom:18px">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 7v5l3 2"/></svg>
    <div>
      This episode is scheduled for <%= it.helpers.formatDateTime(episode.pubDate) %>, so it is not in
      the feed yet and no podcast app can see it. It joins the feed on its own at that time — nothing
      needs to be running and nobody needs to click anything. Subscribers then see it whenever their app
      next checks, on the app's own schedule. To publish it now, set the publish date below to a time
      in the past.
    </div>
  </div>
<% } else if (episode.status === 'missing') { %>
  <div class="notice warn" style="margin-bottom:18px">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
    <div>This episode's file is not on disk right now, so it stays in the feed in case the share is
      briefly unavailable. It drops out automatically once the grace period passes.</div>
  </div>
<% } else if (episode.status === 'removed') { %>
  <div class="notice info" style="margin-bottom:18px">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
    <div>
      This episode is not in the feed. The audio file is still on disk, and rescans will leave it out.
      <form method="post" action="/ui/episodes/<%= encodeURIComponent(episode.id) %>/restore" class="inline-form">
        <button class="btn btn-ghost btn-sm" type="submit">Restore to feed</button>
      </form>
    </div>
  </div>
<% } %>

<div class="form-card file-facts">
  <div class="file-facts__icon" aria-hidden="true">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="12" x2="6" y2="12"/><line x1="9" y1="8" x2="9" y2="16"/><line x1="12" y1="5" x2="12" y2="19"/><line x1="15" y1="8" x2="15" y2="16"/><line x1="18" y1="11" x2="18" y2="13"/></svg>
  </div>
  <div class="file-facts__main">
    <div class="ds-caption">Audio preview</div>
    <div class="waveform" aria-hidden="true">
      <% for (const height of it.helpers.waveformBars(episode.id) ) { %><i style="height:<%= height %>%"></i><% } %>
    </div>
    <audio class="file-facts__player" controls preload="none" src="<%= episode.localMediaUrl %>">
      <a href="<%= episode.localMediaUrl %>">Download this episode</a>
    </audio>
  </div>
  <div class="file-facts__stats">
    <span class="mono"><%= it.helpers.formatDuration(episode.durationSeconds) %></span>
    <span class="mono"><%= it.helpers.formatBytes(episode.fileSizeBytes) %></span>
    <span class="mono"><%= episode.bitrateKbps ? episode.bitrateKbps + ' kbps' : '—' %></span>
  </div>
</div>

<% if (it.transcript) { %>
  <%~ include('../partials/episode-transcript.eta', { transcript: it.transcript, show, episode, helpers: it.helpers }) %>
<% } %>

<%~ include('../partials/episode-form', { episode, show, helpers: it.helpers }) %>

<%
  /* Per-file statistics. The log below is the answer to "did this episode actually
     download?" — the question that used to require a screenshot of someone's phone. */
  const reach = episode.stats || { downloads: 0, streams: 0, failures: 0, bytes: 0, lastAt: null };
%>
<section class="form-card">
  <div class="episode-table__head" style="justify-content:space-between">
    <div>
      <div class="ftitle" style="margin:0">This episode's reach</div>
      <div class="fdesc" style="margin:2px 0 0">
        <% if (reach.lastAt) { %>
          Last fetched <%= it.helpers.relativeTime(reach.lastAt) %>.
        <% } else { %>
          No podcast app has fetched this episode yet.
        <% } %>
      </div>
    </div>
    <a class="btn btn-ghost btn-sm" href="/stats?showId=<%= encodeURIComponent(show.slug) %>">All shows</a>
  </div>

  <div class="reach-row">
    <div class="reach-stat">
      <div class="reach-stat__n"><%= reach.downloads.toLocaleString('en') %></div>
      <div class="reach-stat__l">downloads</div>
    </div>
    <div class="reach-stat">
      <div class="reach-stat__n"><%= reach.streams.toLocaleString('en') %></div>
      <div class="reach-stat__l">streams</div>
    </div>
    <div class="reach-stat">
      <div class="reach-stat__n"><%= it.helpers.formatBytes(reach.bytes) %></div>
      <div class="reach-stat__l">served</div>
    </div>
    <div class="reach-stat<%= reach.failures ? ' reach-stat--bad' : '' %>">
      <div class="reach-stat__n"><%= reach.failures.toLocaleString('en') %></div>
      <div class="reach-stat__l">failed</div>
    </div>
  </div>

  <div style="margin-top:18px">
    <%~ include('../partials/access-log', {
      entries: it.episodeLog,
      total: it.episodeLogTotal,
      hideEpisode: true,
      helpers: it.helpers,
    }) %>
  </div>
</section>
