<%
  const show = it.show;
  const sub = it.subscription;
%>
<div class="page-title">
  <div>
    <div class="sub">Following a feed into <%= show.title %></div>
    <h1>Follow a feed</h1>
  </div>
  <div class="actions">
    <a class="btn btn-ghost btn-sm" href="/shows/<%= encodeURIComponent(show.slug) %>">Back to show</a>
  </div>
</div>

<% if (!it.featureEnabled) { %>
  <div class="notice warn" role="status" style="margin-bottom:18px">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
    <div>
      <strong>Following feeds is switched off.</strong>
      It is off by default, because it is the only thing that makes SelfPod fetch from the
      internet at all — with it off, SelfPod only ever talks to your own network.
      Turn it on in <a href="/settings">Settings</a> when you want to use it.
    </div>
  </div>
<% } %>

<div class="sub-grid">
  <div class="sub-grid__main">
    <%~ include('../partials/subscription-form.eta', { show, subscription: sub, helpers: it.helpers, errors: it.errors, values: it.values, saved: it.saved, reopened: it.reopened }) %>
    <div id="subscription-preview"></div>
  </div>

  <% if (sub) { %>
    <div class="sub-grid__side">
      <div class="form-card">
        <h2 class="ftitle">Status</h2>
        <dl class="kv">
          <dt>Last checked</dt>
          <dd><%= sub.lastPolledAt ? it.helpers.formatDateTime(sub.lastPolledAt) : 'not yet' %></dd>
          <dt>Next check</dt>
          <dd><%= sub.enabled ? (sub.nextPollAt ? it.helpers.formatDateTime(sub.nextPollAt) : 'as soon as possible') : 'paused' %></dd>
          <dt>In your feed</dt>
          <dd><%= sub.counts.downloaded || 0 %> <%= (sub.counts.downloaded || 0) === 1 ? 'episode' : 'episodes' %></dd>
        </dl>

        <% if (sub.lastError) { %>
          <div class="notice <%= sub.lastStatus === 'blocked' ? 'err' : 'warn' %>" role="status" style="margin-bottom:16px">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
            <div>
              <%= sub.lastError %>
              <% if (sub.lastStatus === 'blocked') { %>
                <div class="dim">SelfPod has stopped checking this feed. Fix the address and switch it back on.</div>
              <% } %>
            </div>
          </div>
        <% } %>

        <%
          /* Each of these answers with HX-Redirect back to this page and the message on
             the flash (fragments.js, afterSubscriptionAction): the status card, the next
             check and the ledger all change at once, which is the whole page. The
             button is held and shows it is working until then — a check downloads. */
        %>
        <div class="form-actions">
          <form method="post" action="/ui/subscriptions/<%= sub.id %>/poll"
                hx-post="/ui/subscriptions/<%= sub.id %>/poll" hx-swap="none"
                hx-indicator="find [type=submit]" hx-disabled-elt="find [type=submit]" hx-sync="this:drop">
            <button class="btn btn-ink btn-sm" type="submit">Check now</button>
          </form>
          <form method="post" action="/ui/subscriptions/<%= sub.id %>/toggle"
                hx-post="/ui/subscriptions/<%= sub.id %>/toggle" hx-swap="none"
                hx-indicator="find [type=submit]" hx-disabled-elt="find [type=submit]" hx-sync="this:drop">
            <button class="btn btn-ghost btn-sm" type="submit"><%= sub.enabled ? 'Pause' : 'Resume' %></button>
          </form>
        </div>
      </div>

      <div class="form-card danger-zone">
        <h2 class="ftitle">Stop following</h2>
        <div class="fdesc">
          The episodes SelfPod already downloaded stay exactly where they are — in your feed
          and on your share. Only the checking stops.
        </div>
        <%
          /* With script on, a confirmation first (partials/modal-stop-following.eta);
             without it, the plain form posts and the page comes back with the message. */
        %>
        <form method="post" action="/ui/subscriptions/<%= sub.id %>/delete"
              hx-get="/ui/modals/stop-following/<%= sub.id %>" hx-target="#modal-root" hx-swap="innerHTML">
          <button class="btn btn-danger btn-sm" type="submit" id="stop-following">Stop following this feed…</button>
        </form>
      </div>
    </div>
  <% } %>
</div>

<% if (sub) { %>
  <%~ include('../partials/subscription-items.eta', it.ledger) %>
<% } %>
