<%
  const o = it.overview;
  const rows = it.showStats || [];
  const busiest = it.busiest || [];
  const periodLabel = it.range.days ? `the previous ${it.range.days} days` : 'the previous period';

  /* One place decides whether a movement is good news. More downloads and more failures
     are not the same news, so the card says which way it reads and the helper works out
     the tone; the stylesheet never has to know which card it is on. */
  function change(key, higherIsBetter) {
    return it.helpers.changeLine(o.change?.[key], { higherIsBetter, periodLabel });
  }
%>
<div class="page-title">
  <div>
    <div class="sub">
      <% if (o.lastEverAt) { %>last request <%= it.helpers.relativeTime(o.lastEverAt) %><% } else { %>no requests recorded yet<% } %>
      · <%= it.range.label.toLowerCase() %>
    </div>
    <h1>Statistics</h1>
  </div>
</div>

<%~ include('../partials/stats-range', it) %>

<div class="stat-grid">
  <%
    const cards = [
      { n: o.downloads.toLocaleString('en'), l: 'Downloads', d: change('downloads', true),
        h: 'whole-file fetches — an app saving an episode for offline listening' },
      { n: o.streams.toLocaleString('en'), l: 'Streams', d: change('streams', true),
        h: 'partial fetches — a player starting playback or seeking' },
      { n: it.helpers.formatBytes(o.bytes), l: 'Audio served', d: change('bytes', true),
        h: 'total sent to subscribers' },
      { n: o.failures.toLocaleString('en'), l: 'Failed requests', d: change('failures', false),
        bad: Boolean(o.failures),
        h: o.failures ? 'something a subscriber asked for could not be served' : 'nothing has failed' },
    ];
  %>
  <% for (const card of cards) { %>
    <div class="stat-card<%= card.bad ? ' stat-card--bad' : '' %>">
      <div class="stat-card__n"><%= card.n %></div>
      <div class="stat-card__l"><%= card.l %></div>
      <% if (card.d) { %>
        <div class="stat-card__d stat-card__d--<%= card.d.tone %>">
          <span aria-hidden="true"><%= card.d.glyph %></span><%= card.d.label %>
        </div>
      <% } else { %>
        <div class="stat-card__d stat-card__d--none">no earlier period to compare with</div>
      <% } %>
      <div class="stat-card__h"><%= card.h %></div>
    </div>
  <% } %>
</div>

<p class="help-note" style="margin:16px 0 18px">
  These are <strong>requests, not listens</strong> — no podcast server can know whether someone actually
  played an episode, and SelfPod does not pretend otherwise. Requests you make yourself from this admin
  interface are not counted. SelfPod records the app family (“Pocket Casts”, “Apple Podcasts”) but
  deliberately stores neither IP addresses nor feed tokens.
</p>

<% if (it.failures.length) { %>
  <div class="notice err" style="margin-bottom:18px">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
    <div>
      <strong><%= it.failures.length === 1 ? 'One request failed' : it.failures.length + ' recent requests failed' %>.</strong>
      A subscriber asked for something and did not get it.
      <ul class="notice__list">
        <% for (const row of it.failures.slice(0, 5)) { %>
          <li>
            <%= it.helpers.relativeTime(row.requestedAt) %> —
            <%= row.episodeTitle || row.showTitle || 'unknown' %>
            <span class="mono">(<%= row.statusCode %>)</span>
            <% if (row.error) { %><br><span class="dim"><%= row.error %></span><% } %>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
<% } %>

<%~ include('../partials/stats-chart-daily', it) %>
<%~ include('../partials/stats-chart-apps', it) %>

<div class="form-card" style="margin-bottom:18px">
  <div class="ftitle">Per show</div>
  <div class="fdesc">Downloads and streams counted separately, plus how often podcast apps checked the feed.</div>
  <% if (!rows.length) { %>
    <div class="empty"><div class="empty__title">No shows yet</div></div>
  <% } else { %>
    <div class="table-scroll">
      <table class="ep-table">
        <thead>
          <tr>
            <th scope="col">Show</th>
            <th scope="col">Downloads</th>
            <th scope="col">Streams</th>
            <th scope="col">Served</th>
            <th scope="col">Feed checks</th>
            <th scope="col">Failures</th>
          </tr>
        </thead>
        <tbody>
          <% for (const row of rows) { %>
            <tr>
              <td>
                <div class="ep-title">
                  <a href="/shows/<%= encodeURIComponent(row.slug) %>"><%= row.title %></a>
                  <small><%= row.episodesTouched %> episode<%= row.episodesTouched === 1 ? '' : 's' %> fetched</small>
                </div>
              </td>
              <td class="mono"><%= row.downloads.toLocaleString('en') %></td>
              <td class="mono"><%= row.streams.toLocaleString('en') %></td>
              <td class="size"><%= it.helpers.formatBytes(row.bytes) %></td>
              <td class="mono" title="<%= row.feedLastAt ? 'Last checked ' + it.helpers.formatDateTime(row.feedLastAt) + (row.feedLastClient ? ' by ' + row.feedLastClient : '') : 'No podcast app has checked this feed yet' %>">
                <%= row.feedFetches.toLocaleString('en') %>
                <% if (row.feedLastAt) { %>
                  <small class="dim">· <%= it.helpers.relativeTime(row.feedLastAt) %></small>
                <% } %>
              </td>
              <td>
                <% if (row.failures) { %>
                  <a class="badge badge-err badge--tight" href="/stats?showId=<%= encodeURIComponent(row.slug) %>&failuresOnly=1"><span class="d" aria-hidden="true"></span><%= row.failures %></a>
                <% } else { %>
                  <span class="dim">none</span>
                <% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<% if (busiest.length) { %>
  <div class="form-card" style="margin-bottom:18px">
    <div class="ftitle">Most fetched episodes</div>
    <div class="fdesc">Across every show, by downloads then streams.</div>
    <div class="table-scroll">
      <table class="ep-table">
        <thead>
          <tr>
            <th scope="col">Episode</th>
            <th scope="col">Downloads</th>
            <th scope="col">Streams</th>
            <th scope="col">Served</th>
            <th scope="col">Last fetched</th>
          </tr>
        </thead>
        <tbody>
          <% for (const row of busiest) { %>
            <tr>
              <td>
                <div class="ep-title">
                  <a href="/shows/<%= encodeURIComponent(row.showSlug) %>/episodes/<%= encodeURIComponent(row.episodeId) %>"><%= row.title %></a>
                  <small><%= row.showTitle %></small>
                </div>
              </td>
              <td class="mono"><%= row.downloads.toLocaleString('en') %></td>
              <td class="mono"><%= row.streams.toLocaleString('en') %></td>
              <td class="size"><%= it.helpers.formatBytes(row.bytes) %></td>
              <td class="ep-date mono"><%= it.helpers.relativeTime(row.lastAt) %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<div class="form-card">
  <div class="ftitle">Access log</div>
  <div class="fdesc">
    <%= it.total.toLocaleString('en') %> request<%= it.total === 1 ? '' : 's' %> match<%= it.total === 1 ? 'es' : '' %>
    these filters. The CSV holds every one of them, not only the rows loaded here.
  </div>

  <%~ include('../partials/stats-log-filters', it) %>
  <%~ include('../partials/access-log', it) %>
</div>
