<%
  /* The ledger card: a heading, the filters, and the table.

     The filters swap only the table (#subscription-ledger), never this card, so the
     search box keeps the cursor while someone is still typing into it. Anything that
     changes the counts in the filter — fetching an episode by hand — replaces the
     whole card instead, because a chip reading "(495)" beside a table that no longer
     has 495 rows in it is worse than a redraw. */
  const sub = it.subscription;
  const counts = it.counts || {};
  const filter = it.filter;
  const base = `/ui/subscriptions/${sub.id}/items`;
  const page = `/shows/${encodeURIComponent(it.show.slug)}/subscription`;
  const swap = {
    get: `${base}/table`,
    target: '#subscription-ledger',
  };
%>
<div class="form-card" id="subscription-items">
  <div class="episode-table__head">
    <div class="ftitle" style="margin:0">Every episode SelfPod has seen</div>
    <span class="badge badge-mute"><%= counts.total || 0 %></span>
    <span class="episode-table__order">newest first ↓</span>
  </div>
  <p class="help-note" style="margin:0 0 14px">
    Including the ones it skipped, and why. This is the answer to “where is that episode?”.
  </p>

  <%
    /* A real GET form around the controls, so with JavaScript off the browser
       submits it and the page comes back filtered — the rule every filter bar in
       the app follows. htmx only changes what comes back, never what is sent. */
  %>
  <form class="filter-bar" method="get" action="<%= page %>" style="margin-bottom:16px">
    <div class="filter-bar__group">
      <label class="filter-bar__label" for="ledger-q">Search</label>
      <input class="filter-bar__search" id="ledger-q" type="search" name="q" maxlength="120"
             placeholder="Title or filename" value="<%= filter.search %>"
             hx-get="<%= swap.get %>" hx-include="closest form"
             hx-trigger="input changed delay:300ms, search"
             hx-target="<%= swap.target %>" hx-swap="outerHTML">
    </div>

    <div class="filter-bar__group">
      <label class="filter-bar__label" for="ledger-decision">What happened</label>
      <select id="ledger-decision" name="decision"
              hx-get="<%= swap.get %>" hx-include="closest form"
              hx-target="<%= swap.target %>" hx-swap="outerHTML">
        <option value="">Everything (<%= counts.total || 0 %>)</option>
        <%
          /* Only decisions this feed has actually produced. An empty "Downloading (0)"
             on every feed that has never had a download in flight is a control that
             promises a view of nothing. */
        %>
        <% for (const entry of it.helpers.ledgerDecisions) { %>
          <% if (counts[entry.value]) { %>
            <option value="<%= entry.value %>"<%= filter.decision === entry.value ? ' selected' : '' %>>
              <%= entry.label %> (<%= counts[entry.value] %>)
            </option>
          <% } %>
        <% } %>
      </select>
    </div>

    <div class="filter-bar__group">
      <label class="filter-bar__label" for="ledger-published">Published</label>
      <select id="ledger-published" name="published"
              hx-get="<%= swap.get %>" hx-include="closest form"
              hx-target="<%= swap.target %>" hx-swap="outerHTML">
        <%
          /* "Any time" is the empty value rather than an "all time" key, so the
             default leaves nothing in the URL and a bare page URL is the whole
             history — which is what this table is for. */
        %>
        <option value="">Any time</option>
        <% for (const range of it.rangeOptions) { %>
          <option value="<%= range.key %>"<%= filter.published?.key === range.key ? ' selected' : '' %>>
            <%= range.label %>
          </option>
        <% } %>
      </select>
    </div>

    <span class="filter-bar__spacer"></span>
    <%
      /* Deliberately a plain link, not an htmx swap: clearing has to put the controls
         back to their empty state as well as the table, and only a real navigation
         does both without a second copy of the form's state to keep in step.

         Always rendered, rather than only when something is filtered: a filter changed
         through htmx swaps the table and leaves this bar alone, so a button that
         appeared with the filter would be a button that never appeared. */
    %>
    <a class="btn btn-ghost btn-sm" href="<%= page %>">Clear</a>
    <noscript><button class="btn btn-ghost btn-sm" type="submit">Filter</button></noscript>
  </form>

  <%~ include('../partials/subscription-ledger.eta', it) %>
</div>
