<%
  /* Stopping is not undoable — the rules, the ledger and the check schedule go — so it
     asks first, like removing a show does. No typed confirmation: nothing on the share
     is touched, and the sentence says so. */
  const sub = it.subscription;
  const show = it.show;
%>
<dialog class="modal" id="modal" aria-labelledby="modal-title">
  <h2 class="modal__title" id="modal-title">Stop following this feed?</h2>
  <form class="modal__body" method="post" action="/ui/subscriptions/<%= sub.id %>/delete"
        hx-post="/ui/subscriptions/<%= sub.id %>/delete" hx-swap="none"
        hx-indicator="find [type=submit]" hx-disabled-elt="find [type=submit]" hx-sync="this:drop">
    <p>
      SelfPod will stop checking <span class="mono"><%= sub.feedUrl %></span> for new episodes,
      and forget the rules and the list of what it has seen there.
    </p>
    <p>
      The <%= sub.counts.downloaded || 0 %> episode<%= (sub.counts.downloaded || 0) === 1 ? '' : 's' %>
      it already downloaded into <strong><%= show.title %></strong> stay exactly where they are — in
      your feed and on your share.
    </p>
    <div class="modal__actions">
      <button class="btn btn-ghost btn-sm" type="button" data-modal-close>Cancel</button>
      <button class="btn btn-danger btn-sm" type="submit">Stop following</button>
    </div>
  </form>
</dialog>
