<%
  const errors = it.errors || {};
%>
<dialog class="modal" id="modal" aria-labelledby="modal-title">
  <h2 class="modal__title" id="modal-title">Change admin password</h2>
  <%
    const aria = (field, id) => errors[field] ? ` aria-invalid="true" aria-describedby="${id}-error"` : '';
  %>
  <form class="modal__body" method="post" action="/ui/settings/password"
        hx-post="/ui/settings/password" hx-target="#modal-root" hx-swap="innerHTML"
        hx-indicator="find [type=submit]" hx-disabled-elt="find [type=submit]" hx-sync="this:drop">
    <div class="field<%= errors.currentPassword ? ' is-invalid' : '' %>">
      <label for="p-current">Current password</label>
      <input id="p-current" name="currentPassword" type="password" autocomplete="current-password" required autofocus<%~ aria('currentPassword', 'p-current') %>>
      <% if (errors.currentPassword) { %><div class="field-error" id="p-current-error"><%= errors.currentPassword %></div><% } %>
    </div>
    <div class="field<%= errors.password ? ' is-invalid' : '' %>">
      <label for="p-new">New password</label>
      <input id="p-new" name="password" type="password" autocomplete="new-password" required minlength="10"<%~ aria('password', 'p-new') %>>
      <% if (errors.password) { %>
        <div class="field-error" id="p-new-error"><%= errors.password %></div>
      <% } else { %>
        <div class="hint">At least 10 characters.</div>
      <% } %>
    </div>
    <div class="field<%= errors.passwordConfirm ? ' is-invalid' : '' %>">
      <label for="p-confirm">Confirm new password</label>
      <input id="p-confirm" name="passwordConfirm" type="password" autocomplete="new-password" required<%~ aria('passwordConfirm', 'p-confirm') %>>
      <% if (errors.passwordConfirm) { %><div class="field-error" id="p-confirm-error"><%= errors.passwordConfirm %></div><% } %>
    </div>
    <div class="modal__actions">
      <button class="btn btn-ghost btn-sm" type="button" data-modal-close>Cancel</button>
      <button class="btn btn-primary btn-sm" type="submit">Change password</button>
    </div>
  </form>
</dialog>
