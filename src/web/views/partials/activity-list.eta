<%
  /* The scan log's swap target. It holds the empty states and nothing else of its
     own: the rows and the pager live in activity-items.eta, so "Show older" can ask
     for items without being handed another copy of this container. */
  const noProblems = it.filter.outcome === 'problems';
%>
<div class="log-list" id="activity-list">
  <% if (!it.entries.length) { %>
    <div class="empty">
      <% if (noProblems) { %>
        <div class="empty__title">No scans had problems</div>
        <p class="empty__hint">Nothing has failed or warned in the scans recorded here.
          This is the good outcome.</p>
      <% } else { %>
        <div class="empty__title">No scans yet</div>
        <p class="empty__hint">SelfPod records every scan here — what it found, what it added, and anything
          that went wrong, in plain language.</p>
      <% } %>
    </div>
  <% } else { %>
    <%~ include('../partials/activity-items', it) %>
  <% } %>
</div>
