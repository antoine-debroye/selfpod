<header class="topbar">
  <button class="nav-toggle" type="button" data-nav-toggle aria-label="Show navigation" aria-expanded="false" aria-controls="sidebar">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" width="18" height="18"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
  </button>

  <nav class="crumbs" aria-label="Breadcrumb">
    <% const crumbs = it.crumbs || [{ label: 'Dashboard' }]; %>
    <% for (const [i, crumb] of crumbs.entries()) { %>
      <% if (i > 0) { %> / <% } %>
      <% if (crumb.href && i < crumbs.length - 1) { %>
        <a href="<%= crumb.href %>"><%= crumb.label %></a>
      <% } else { %>
        <b><%= crumb.label %></b>
      <% } %>
    <% } %>
  </nav>

  <div class="right">
    <% if (it.publicBaseUrl) { %>
      <button class="public-url" type="button" data-health-test data-url="<%= it.publicBaseUrl %>/health"
              title="Test this address — from your browser, and from SelfPod itself">
        <span class="d" aria-hidden="true"></span>
        <span class="public-url__host"><%= it.publicBaseUrlHost %></span>
        <span class="public-url__action">· test</span>
      </button>
    <% } else { %>
      <a class="public-url public-url--unset" href="/settings">
        <span class="d d--warn" aria-hidden="true"></span>
        No public address set
      </a>
    <% } %>

    <%~ it.topbarActions || '' %>
  </div>
</header>
