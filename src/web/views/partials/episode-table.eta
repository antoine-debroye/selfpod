<%
  const show = it.show;
  const episodes = it.episodes || [];
  const scheduled = episodes.filter((e) => e.scheduled);
  const inFeed = episodes.filter((e) => e.status !== 'removed' && !e.scheduled);
  const removed = episodes.filter((e) => e.status === 'removed');
%>
<div class="form-card" id="episode-table">
  <div class="episode-table__head">
    <div class="ftitle" style="margin:0">Episodes</div>
    <span class="badge badge-mute"><%= inFeed.length %></span>
    <% if (scheduled.length) { %>
      <span class="badge badge-info badge--tight"><span class="d" aria-hidden="true"></span><%= scheduled.length %> scheduled</span>
    <% } %>
    <span class="episode-table__order">ordered by publish date ↓</span>
  </div>

  <% if (scheduled.length) { %>
    <p class="help-note" style="margin:10px 0 0">
      <strong><%= scheduled.length %> episode<%= scheduled.length === 1 ? ' is' : 's are' %> waiting on a publish date in the future</strong>,
      so <%= scheduled.length === 1 ? 'it is' : 'they are' %> not in the feed and no podcast app can see
      <%= scheduled.length === 1 ? 'it' : 'them' %> yet. Each one joins the feed by itself at its own
      time — nothing needs to be running. To publish one now, set its publish date to a time in the past.
    </p>
  <% } %>

  <% if (!episodes.length) { %>
    <div class="empty">
      <div class="empty__title">No audio yet</div>
      <p class="empty__hint">
        Drop files into <code><%= show.folder %></code> over SMB, NFS or <span class="mono">docker cp</span> —
        they appear here on their own. Or
        <a href="/shows/<%= encodeURIComponent(show.slug) %>/upload">upload through the browser</a>.
        Supported: <%= it.helpers.supportedFormats %>.
      </p>
    </div>
  <% } else { %>
    <div class="table-scroll">
      <table class="ep-table ep-table--pinned">
        <thead>
          <tr>
            <th scope="col">Title</th>
            <th scope="col">Published</th>
            <th scope="col" title="When SelfPod first saw this file on disk">Added</th>
            <th scope="col">Duration</th>
            <th scope="col">Size</th>
            <th scope="col" title="Whole-file downloads / partial streams">Fetches</th>
            <th scope="col">Status</th>
            <th scope="col"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% for (const episode of episodes) { %>
            <%~ include('../partials/episode-row', { episode, show, helpers: it.helpers }) %>
          <% } %>
        </tbody>
      </table>
    </div>

    <p class="help-note" style="margin-top:14px">
      <strong>Fetches</strong> counts whole-file downloads first, then partial streams — a download is an app
      saving the episode, a stream is a player seeking through it. Neither means someone listened.
      <a href="/stats?showId=<%= encodeURIComponent(show.slug) %>">See the full access log</a>.
    </p>

    <p class="help-note" style="margin-top:10px">
      <strong>Remove from feed</strong> keeps the audio file and can be undone — a rescan will not bring the
      episode back on its own. <strong>Delete file</strong> erases the audio from disk and cannot be undone.
      <% if (removed.length) { %>
        <%= removed.length %> episode<%= removed.length === 1 ? '' : 's' %> currently removed from the feed.
      <% } %>
    </p>
  <% } %>
</div>
