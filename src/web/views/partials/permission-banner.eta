<%
  /* Spec §13.1 step 4: a permission failure must be visible in the web UI, not
     only in the container logs, so it can be diagnosed without SSH. This renders
     from the in-memory health registry, which stays readable even when the
     database or the shows folder is not. */
  const issues = it.issues || [];
%>
<% for (const issue of issues) { %>
  <div class="banner banner--<%= issue.level === 'error' ? 'err' : 'warn' %>" role="<%= issue.level === 'error' ? 'alert' : 'status' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" width="18" height="18">
      <% if (issue.level === 'error') { %>
        <path d="M12 9v4M12 17h.01M10.3 3.9 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/>
      <% } else { %>
        <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
      <% } %>
    </svg>
    <div class="banner__body"><%= issue.message %></div>
  </div>
<% } %>
