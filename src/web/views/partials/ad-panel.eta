<%
  /* The Adverts panel: what SelfPod still has to do, what it has cut, the rules it cuts
     by, every episode as a bar, and the settings. One swap target, so every decision
     re-renders all of it and nothing on the page can go on describing the old state.
     Every sentence comes from services/adverts-view.js. */
  const show = it.show;
  const slug = encodeURIComponent(show.slug);
  const mode = it.mode ?? 'off';
  const rules = it.rules ?? { rows: [], kept: [] };
  const timeline = it.timeline ?? { episodes: [], nextBefore: null };
%>
<div id="cuts-panel" class="cuts-panel"
     hx-get="/ui/shows/<%= slug %>/ad-panel"
     hx-trigger="sse:ad-changed-<%= show.id %> from:body"
     hx-swap="outerHTML">

  <div id="cuts-work" class="cuts-work" role="status" aria-live="polite"
       sse-swap="cuts-work-<%= show.id %>" hx-swap="innerHTML"><%~ it.workHtml ?? '' %></div>

  <% if (it.formError) { %>
    <div class="notice warn" role="alert"><%= it.formError %></div>
  <% } %>

  <% if (it.off) { %>
    <div class="notice info" role="status">
      <div><%= it.offSentence %></div>
    </div>
  <% } else { %>

    <dl class="cuts-totals">
      <% for (const figure of it.totals ?? []) { %>
        <div class="cuts-totals__item"><dt><%= figure.label %></dt><dd><%= figure.value %></dd></div>
      <% } %>
    </dl>
    <% if (it.heldSentence) { %><p class="cuts-note cuts-note--warn"><%= it.heldSentence %></p><% } %>
    <% if (it.failedSentence) { %><p class="cuts-note cuts-note--warn"><%= it.failedSentence %></p><% } %>
    <% if (it.engineSentence) { %><p class="cuts-note cuts-note--warn"><%= it.engineSentence %></p><% } %>

    <section class="form-card" id="cuts-rules">
      <div class="ftitle">What SelfPod cuts</div>
      <% if (rules.rows.length) { %>
        <ul class="rules">
          <% for (const rule of rules.rows) { %>
            <li class="rule rule--<%= rule.kind %><%= rule.offered ? ' rule--offered' : '' %>">
              <div class="rule__main">
                <div class="rule__title"><%= rule.title %></div>
                <div class="rule__detail"><%= rule.detail %></div>
                <% if (rule.sampleUrl) { %><audio class="rule__sample" controls preload="none" src="<%= rule.sampleUrl %>"></audio><% } %>
              </div>
              <div class="rule__act">
                <% for (const action of rule.actions) { %>
                  <%~ include('./ad-action.eta', { action, target: '#cuts-panel', returnTo: null }) %>
                <% } %>
              </div>
            </li>
          <% } %>
        </ul>
      <% } else if (it.emptySentence) { %>
        <p class="muted"><%= it.emptySentence %></p>
      <% } %>

      <form class="rule-teach" method="post" action="/ui/shows/<%= slug %>/ad-markers"
            hx-post="/ui/shows/<%= slug %>/ad-markers" hx-target="#cuts-panel" hx-swap="outerHTML">
        <label class="rule-teach__lead" for="boundary-position">The programme</label>
        <select id="boundary-position" name="position">
          <option value="starts">starts when it says</option>
          <option value="ends">ends after it says</option>
          <option value="ends_inclusive">ends, and these words go too</option>
        </select>
        <label class="sr-only" for="boundary-text">Words</label>
        <input id="boundary-text" type="text" name="text" maxlength="200" placeholder="Vous écoutez RMC" required>
        <button class="btn btn-sm btn-primary" type="submit">Teach</button>
      </form>

      <% if (rules.kept.length) { %>
        <details class="rules-kept">
          <summary>Kept (<%= rules.kept.length %>)</summary>
          <ul class="rules">
            <% for (const rule of rules.kept) { %>
              <li class="rule rule--kept">
                <div class="rule__main">
                  <div class="rule__title"><%= rule.title %></div>
                  <div class="rule__detail"><%= rule.detail %></div>
                </div>
                <div class="rule__act">
                  <% for (const action of rule.actions) { %>
                    <%~ include('./ad-action.eta', { action, target: '#cuts-panel', returnTo: null }) %>
                  <% } %>
                </div>
              </li>
            <% } %>
          </ul>
        </details>
      <% } %>
    </section>

    <section class="form-card" id="cuts-timeline">
      <div class="ftitle">Episode by episode</div>
      <%~ include('./ad-timeline-items.eta', { show, timeline }) %>
    </section>
  <% } %>

  <details class="form-card cuts-settings" <%= mode === 'off' ? 'open' : '' %>>
    <summary class="ftitle">Settings</summary>
    <form method="post" action="/ui/shows/<%= slug %>/ad-trim"
          hx-post="/ui/shows/<%= slug %>/ad-trim" hx-target="#cuts-panel" hx-swap="outerHTML">
      <fieldset class="modal__choices">
        <legend class="sr-only">What should SelfPod do about adverts?</legend>
        <label class="choice">
          <input type="radio" name="mode" value="off" <%= mode === 'off' ? 'checked' : '' %>>
          <span class="choice__body">
            <strong>Nothing</strong>
            <small>Episodes are published exactly as they arrive.</small>
          </span>
        </label>
        <label class="choice">
          <input type="radio" name="mode" value="review" <%= mode === 'review' ? 'checked' : '' %>>
          <span class="choice__body">
            <strong>Ask me</strong>
            <small>Hold an episode until you have decided about what is waiting. What you remove once is cut from later episodes without asking.</small>
          </span>
        </label>
        <label class="choice">
          <input type="radio" name="mode" value="auto" <%= mode === 'auto' ? 'checked' : '' %>>
          <span class="choice__body">
            <strong>Cut what it is sure of</strong>
            <small>Sponsor reads that come back, and a station jingle heard in every recent episode, are cut without asking. The rest waits here and the episode goes out untouched.</small>
          </span>
        </label>
      </fieldset>

      <fieldset class="listen-scope">
        <legend class="ds-caption">Where to listen</legend>
        <div class="form-row">
          <div class="field">
            <label for="listen-head">First</label>
            <div class="field-unit">
              <input id="listen-head" type="number" name="listenHeadMinutes" min="0" max="15" step="1"
                     value="<%= it.listen?.headMinutes ?? 5 %>"> <span class="muted">minutes</span>
            </div>
          </div>
          <div class="field">
            <label for="listen-tail">Last</label>
            <div class="field-unit">
              <input id="listen-tail" type="number" name="listenTailMinutes" min="0" max="15" step="1"
                     value="<%= it.listen?.tailMinutes ?? 4 %>"> <span class="muted">minutes</span>
            </div>
          </div>
        </div>
        <label class="choice choice--inline">
          <input type="checkbox" name="listenWhole" value="1" <%= it.listen?.whole ? 'checked' : '' %>>
          <span class="choice__body">
            <strong>The whole episode</strong>
            <small>Catches mid-roll reads too, at the cost of listening to all of it.</small>
          </span>
        </label>
        <% if (it.listen?.rateLabel) { %>
          <div class="hint">On this machine listening runs at <%= it.listen.rateLabel %>, so <%= it.listen.costLabel %>.</div>
        <% } %>
      </fieldset>

      <div class="field">
        <label for="min-episodes">Episodes a sound must repeat in before it is cut unasked</label>
        <input id="min-episodes" type="number" name="minEpisodes" min="2" max="20" value="<%= it.minEpisodes ?? 3 %>">
      </div>

      <div class="actions">
        <button class="btn btn-sm btn-primary" type="submit">Save</button>
      </div>
    </form>

    <% if (mode !== 'off') { %>
      <form class="cuts-settings__check" method="post" action="/ui/shows/<%= slug %>/ad-detect"
            hx-post="/ui/shows/<%= slug %>/ad-detect" hx-target="#cuts-panel" hx-swap="outerHTML">
        <span class="muted">SelfPod checks after every scan.</span>
        <button class="btn btn-ghost btn-sm" type="submit">Check now</button>
      </form>
    <% } %>
  </details>
</div>
