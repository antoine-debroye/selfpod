<%
  /* Empty #modal-root plus an optional toast: the response to a successful modal
     action. app.js sees the dialog disappear and puts focus back where it came from.

     The toast is the shared partial, whose *wrapper* carries the out-of-band swap.
     This file used to put hx-swap-oob on the .toast element itself, and htmx inserts
     the children of an oob element rather than the element: the message arrived as
     bare text with a × that had nothing to close. */
%>
<% if (it.toast) { %>
  <%~ include('./toast.eta', { message: it.toast.message, level: it.toast.level || 'ok', helpers: it.helpers }) %>
<% } %>
