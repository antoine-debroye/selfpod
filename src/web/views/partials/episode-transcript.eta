<%
  /* What SelfPod heard in this episode (spec §19.6): the words, with what is cut struck
     through and what is waiting highlighted, and one bar to teach from. Tapping a word
     sets an edge (app.js, "transcript edges"); the two selects are the real edges and
     post with script off. */
  const tx = it.transcript;
  const show = it.show;
  const episode = it.episode;
  const base = `/ui/episodes/${encodeURIComponent(episode.id)}/transcript`;
  const embedded = it.embedded === true;
  const allWords = (tx.regions ?? []).flatMap((region) => region.words);
%>
<% if (embedded) { %><div class="ep-ad__heard" id="episode-transcript"><% } else { %><section class="form-card" id="episode-transcript"
         hx-get="<%= base %>"
         hx-trigger="sse:transcript-<%= episode.id %> from:body<%= tx.state === 'listening' ? ', load delay:10s' : '' %>"
         hx-swap="outerHTML"><% } %>
  <div class="<%= embedded ? 'ds-caption' : 'ftitle' %>">What SelfPod heard</div>
  <% if (tx.state === 'off') { %>
    <p class="muted">SelfPod is not listening to this show. Turn it on from the show's <a href="/shows/<%= encodeURIComponent(show.slug) %>/adverts">Adverts</a> page.</p>
  <% } else if (tx.state === 'unsupported') { %>
    <p class="muted">SelfPod can only read MP3 episodes, and this one is not one.</p>
  <% } else if (tx.state === 'engine_missing') { %>
    <p class="muted">The speech recogniser is not available on this machine, so nothing has been heard.</p>
  <% } else if (tx.state === 'failed') { %>
    <p class="muted"><%= tx.failureSentence %></p>
  <% } else if (tx.state === 'listening') { %>
    <p class="muted">Listening to <%= tx.scopeLabel %>…</p>
  <% } else if (tx.state === 'not_looked') { %>
    <p class="muted">Not listened to yet.</p>
  <% } else { %>
    <p class="muted tx__intro">
      Read by <%= tx.engineLabel %><%= tx.language ? ` in ${tx.languageLabel}` : '' %>.
      <span class="tx__legend">Struck through is cut · highlighted is waiting · dotted underline is a sponsor cue · faded is a word it was unsure of. Tap a first and a last word to teach.</span>
    </p>
    <div class="tx__scope" data-tx-scope>
      <% for (const region of tx.regions) { %>
        <h3 class="tx__heading"><%= region.label %></h3>
        <%~ include('./transcript-words.eta', { words: region.words, cutStartWord: null, cutEndWord: null, excerpt: false, language: region.language, helpers: it.helpers }) %>
      <% } %>
      <% if (allWords.length) { %>
        <form class="tx__teach" method="post" action="<%= base %>/teach" hx-post="<%= base %>/teach"
              hx-target="<%= embedded ? '#episode-adverts' : '#episode-transcript' %>" hx-swap="outerHTML">
          <div class="tx__range muted" data-tx-range aria-live="polite"></div>
          <div class="tx__teach-row">
            <label for="teach-start-<%= episode.id %>">From</label>
            <select id="teach-start-<%= episode.id %>" name="startWord" data-tx-start>
              <% for (const word of allWords) { %><option value="<%= word.i %>"><%= word.t %></option><% } %>
            </select>
            <label for="teach-end-<%= episode.id %>">to</label>
            <select id="teach-end-<%= episode.id %>" name="endWord" data-tx-end>
              <% for (const word of allWords) { %><option value="<%= word.i %>" <%= word.i === allWords[allWords.length - 1].i ? 'selected' : '' %>><%= word.t %></option><% } %>
            </select>
          </div>
          <div class="tx__teach-row">
            <label for="teach-verdict-<%= episode.id %>">is</label>
            <select id="teach-verdict-<%= episode.id %>" name="verdict">
              <option value="advert">an advert — remove it, and the same words later</option>
              <option value="not_advert">not an advert — never offer these words</option>
              <option value="programme_starts">where the programme starts — cut everything before</option>
              <option value="programme_ends">where the programme ends — cut everything after</option>
              <option value="tail_starts">where the closing adverts start — cut these words to the end</option>
            </select>
            <button class="btn btn-sm btn-primary" type="submit">Teach</button>
          </div>
        </form>
      <% } %>
    </div>
  <% } %>
<% if (embedded) { %></div><% } else { %></section><% } %>
