<%
  /* What SelfPod heard in this episode (spec §19.6): the opening and closing words,
     with what was cut struck through and what is waiting highlighted — and the place
     to teach it: "this is an advert", "this is where the programme starts". Refreshed
     over SSE when the transcript lands, and polled while it is being made, so a page
     opened mid-listen catches up on its own. */
  const tx = it.transcript;
  const show = it.show;
  const episode = it.episode;
  const base = `/ui/episodes/${encodeURIComponent(episode.id)}/transcript`;
%>
<section class="form-card" id="episode-transcript"
         hx-get="<%= base %>"
         hx-trigger="sse:transcript-<%= episode.id %> from:body<%= tx.state === 'listening' ? ', load delay:10s' : '' %>"
         hx-swap="outerHTML">
  <div class="ftitle">What SelfPod heard</div>
  <% if (tx.state === 'off') { %>
    <p class="muted">SelfPod is not listening to this show. Turn on advert removal on the show's <a href="/shows/<%= encodeURIComponent(show.slug) %>/adverts">Adverts</a> page and it will read the opening and closing minutes of each episode.</p>
  <% } else if (tx.state === 'unsupported') { %>
    <p class="muted">SelfPod can only read MP3 episodes, and this one is not one. It is published exactly as it arrived.</p>
  <% } else if (tx.state === 'engine_missing') { %>
    <p class="muted">The speech recogniser is not available on this machine, so nothing has been heard. Adverts are still found by comparing episodes by sound.</p>
  <% } else if (tx.state === 'failed') { %>
    <p class="muted"><%= tx.failureSentence %></p>
  <% } else if (tx.state === 'listening') { %>
    <p class="muted">Listening to <%= tx.scopeLabel %>… this page updates on its own when it is done.</p>
  <% } else if (tx.state === 'not_looked') { %>
    <p class="muted">Not listened to yet. SelfPod reads <%= tx.scopeLabel %> on its next check, newest episodes first.</p>
  <% } else { %>
    <p class="muted tx__intro">
      Read by <%= tx.engineLabel %><%= tx.language ? ` in ${tx.languageLabel}` : '' %>.
      <span class="tx__legend">Struck through is removed · highlighted is waiting for you · dotted underline is a sponsor cue · faded is a word it was unsure of.</span>
    </p>
    <% for (const region of tx.regions) { %>
      <details class="tx__region" <%= region.open ? 'open' : '' %>>
        <summary><b><%= region.label %></b> <span class="muted">· <%= region.summary %></span></summary>

        <%~ include('./transcript-words.eta', { words: region.words, cutStartWord: null, cutEndWord: null, excerpt: false, language: region.language, helpers: it.helpers }) %>

        <% for (const mark of region.marks) { %>
          <div class="tx__mark notice <%= mark.status === 'candidate' ? 'warn' : 'info' %>">
            <div>
              <strong><%= mark.status === 'candidate' ? `Waiting for you: ${mark.atLabel}` : mark.status === 'approved' ? `Cut ${mark.atLabel}` : `Kept ${mark.atLabel}` %>.</strong>
              <%= mark.why ? mark.why.sentence : '' %>
            </div>
            <% if (mark.status === 'candidate') { %>
              <form method="post" action="/ui/shows/<%= encodeURIComponent(show.slug) %>/ad-segments/<%= mark.segmentId %>"
                    hx-post="/ui/shows/<%= encodeURIComponent(show.slug) %>/ad-segments/<%= mark.segmentId %>"
                    hx-target="#episode-transcript" hx-swap="outerHTML" class="seg-actions">
                <input type="hidden" name="returnTo" value="episode:<%= episode.id %>">
                <button class="btn btn-sm" type="submit" name="status" value="approved">Remove it</button>
                <button class="btn btn-ghost btn-sm" type="submit" name="status" value="rejected">Not an advert</button>
              </form>
            <% } else if (mark.status === 'approved' && !mark.isMarker) { %>
              <form method="post" action="/ui/shows/<%= encodeURIComponent(show.slug) %>/ad-segments/<%= mark.segmentId %>"
                    hx-post="/ui/shows/<%= encodeURIComponent(show.slug) %>/ad-segments/<%= mark.segmentId %>"
                    hx-target="#episode-transcript" hx-swap="outerHTML" class="seg-actions">
                <input type="hidden" name="returnTo" value="episode:<%= episode.id %>">
                <button class="btn btn-ghost btn-xs" type="submit" name="status" value="rejected">Put it back and stop cutting these words</button>
              </form>
            <% } else if (mark.isMarker) { %>
              <form method="post" action="/ui/shows/<%= encodeURIComponent(show.slug) %>/ad-markers/<%= mark.markerId %>/remove"
                    hx-post="/ui/shows/<%= encodeURIComponent(show.slug) %>/ad-markers/<%= mark.markerId %>/remove"
                    hx-target="#episode-transcript" hx-swap="outerHTML" class="seg-actions">
                <input type="hidden" name="returnTo" value="episode:<%= episode.id %>">
                <button class="btn btn-ghost btn-xs" type="submit">Forget this boundary</button>
              </form>
            <% } %>
          </div>
        <% } %>

        <%
          /* The teaching loop. Pick the words, say what they are. Works with the two
             selects alone; a tap on a word above fills them in when script is on. */
        %>
        <details class="tx__teach">
          <summary>Tell SelfPod about these words</summary>
          <form method="post" action="<%= base %>/teach" hx-post="<%= base %>/teach" hx-target="#episode-transcript" hx-swap="outerHTML">
            <input type="hidden" name="region" value="<%= region.index %>">
            <div class="form-row">
              <div class="field">
                <label for="teach-start-<%= region.index %>">From this word</label>
                <select id="teach-start-<%= region.index %>" name="startWord" data-tx-start>
                  <% for (const word of region.words) { %><option value="<%= word.i %>"><%= word.t %></option><% } %>
                </select>
              </div>
              <div class="field">
                <label for="teach-end-<%= region.index %>">To this word</label>
                <select id="teach-end-<%= region.index %>" name="endWord" data-tx-end>
                  <% for (const word of region.words) { %><option value="<%= word.i %>" <%= word.i === region.words[region.words.length - 1].i ? 'selected' : '' %>><%= word.t %></option><% } %>
                </select>
              </div>
            </div>
            <div class="tx__range muted" data-tx-range aria-live="polite"></div>
            <div class="seg-actions">
              <button class="btn btn-sm" type="submit" name="verdict" value="advert">This is an advert — remove it, and remember the words</button>
              <button class="btn btn-ghost btn-sm" type="submit" name="verdict" value="not_advert">Not an advert — never offer these words</button>
              <% if (region.key !== 'tail') { %>
                <button class="btn btn-ghost btn-sm" type="submit" name="verdict" value="programme_starts" title="Everything before these words is cut, in every episode where SelfPod hears them">The programme starts here</button>
              <% } %>
              <% if (region.key !== 'head') { %>
                <button class="btn btn-ghost btn-sm" type="submit" name="verdict" value="programme_ends" title="Everything after these words is cut, in every episode where SelfPod hears them">The programme ends here</button>
              <% } %>
            </div>
            <div class="hint">A boundary keeps the words you pick and cuts everything on the far side of them — the way to remove a pre-roll that is a different advert every day.</div>
          </form>
        </details>
      </details>
    <% } %>
  <% } %>
</section>
