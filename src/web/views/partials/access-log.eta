<%
  const entries = it.entries || [];
  /* On one episode's own page every row would name the same episode, so the column
     is dropped and the range detail moves into the "What" cell instead. */
  const showEpisode = it.hideEpisode !== true;
  /* The episode page renders this log without a filter object, so there is nothing to
     sort by and no page after this one. Headers fall back to plain text rather than
     links that would go somewhere that does not filter the way this log is filtered. */
  const log = it.log ?? null;

  function header(key, label) {
    if (!log) return { open: '', close: '', aria: '' };
    const active = log.sort === key;
    const next = active && log.dir === 'desc' ? 'ascending' : 'descending';
    const query = log.sortLink(key);
    return {
      aria: active ? ` aria-sort="${log.dir === 'asc' ? 'ascending' : 'descending'}"` : '',
      open:
        `<a class="th-sort" href="/stats${query ? `?${query}` : ''}" title="Sort by ${label.toLowerCase()}, ${next === 'ascending' ? 'smallest' : 'largest'} first"` +
        ` hx-get="/ui/stats/log${query ? `?${query}` : ''}" hx-target="#access-log" hx-swap="outerHTML">`,
      close: `<span class="th-sort__arrow" aria-hidden="true">${active ? (log.dir === 'asc' ? '▲' : '▼') : '▼'}</span></a>`,
    };
  }

  const when = header('time', 'time');
  const sent = header('bytes', 'size sent');
  const result = header('status', 'result');
%>
<div id="access-log">
  <% if (!entries.length) { %>
    <div class="empty">
      <div class="empty__title">
        <% if (it.failuresOnly) { %>No failures recorded<% } else if (log && log.qs) { %>Nothing matches those filters<% } else { %>Nothing here yet<% } %>
      </div>
      <p class="empty__hint">
        <% if (it.failuresOnly) { %>
          No request for an episode, a feed or artwork has failed. This is the good outcome.
        <% } else if (log && log.qs) { %>
          Widen the range or clear a filter. Requests you make yourself from this admin
          interface are never recorded.
        <% } else { %>
          As soon as a podcast app fetches your feed or downloads an episode, it appears here.
          Nothing is recorded for pages you view yourself in SelfPod.
        <% } %>
      </p>
    </div>
  <% } else { %>
    <div class="table-scroll">
      <table class="ep-table log-table">
        <thead>
          <tr>
            <th scope="col"<%~ when.aria %>><%~ when.open %>When<%~ when.close %></th>
            <th scope="col">What</th>
            <% if (showEpisode) { %><th scope="col">Episode or show</th><% } %>
            <th scope="col">App</th>
            <th scope="col"<%~ sent.aria %>><%~ sent.open %>Sent<%~ sent.close %></th>
            <th scope="col"<%~ result.aria %>><%~ result.open %>Result<%~ result.close %></th>
          </tr>
        </thead>
        <tbody id="access-log-rows">
          <%~ include('../partials/access-log-rows', it) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
